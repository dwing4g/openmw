new file mode 100644
index 0000000..f6e5970
--- /dev/null
+++ b/tools/test_bake_anims.py
@@ -0,0 +1,42 @@
+"""Checks for the seal gesture continuation blend; no game assets are read."""
+import math
+import unittest
+from pathlib import Path
+from unittest.mock import patch
+
+import paths
+
+with patch.object(paths, "er_files", return_value=Path("unused")):
+    import bake_anims
+
+
+class ContinuationTests(unittest.TestCase):
+    def test_entrance_starts_at_windup_endpoint_and_preserves_release(self):
+        old = [((0., 1., 2.), (0., 0., 0., 1.))]
+        new = [((2., 3., 4.), (0., 1., 0., 0.))]
+        self.assertIs(bake_anims.continuation_pose(old, new, 0, 7), old)
+        self.assertIs(bake_anims.continuation_pose(old, new, 7, 7), new)
+        # Flame Sling's real cast event is frame 18: smoothing must leave
+        # both the event pose and the rest of the recovery bit-for-bit exact.
+        for frame in range(18, 63):
+            self.assertIs(bake_anims.continuation_pose(old, new, frame, 7), new)
+        position, rotation = bake_anims.continuation_pose(old, new, 3.5, 7)[0]
+        self.assertEqual(position, (1., 2., 3.))
+        self.assertAlmostEqual(sum(v * v for v in rotation), 1.)
+        self.assertAlmostEqual(rotation[1], math.sqrt(.5))
+        self.assertAlmostEqual(rotation[3], math.sqrt(.5))
+
+    def test_equivalent_quaternion_signs_do_not_invert_or_collapse(self):
+        old = [((0., 0., 0.), (0., 0., 0., 1.))]
+        new = [((0., 0., 0.), (0., 0., 0., -1.))]
+        for frame in range(1, 7):
+            self.assertEqual(bake_anims.continuation_pose(old, new, frame, 7)[0][1], old[0][1])
+
+    def test_exact_seams_need_no_second_blend(self):
+        old = [((0., 0., 0.), (0., 0., 0., 1.))]
+        new = [((1., 2., 3.), (0., 0., 1., 0.))]
+        self.assertIs(bake_anims.continuation_pose(old, new, 0, 0), new)
+
+
+if __name__ == "__main__":
+    unittest.main()
