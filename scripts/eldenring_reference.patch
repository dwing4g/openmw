+def continuation_pose(previous, current, frame, blend):
+    """Bake a continuation's entrance blend, leaving its later samples exact."""
+    if blend <= 0 or frame >= blend:
+        return current
+    if frame <= 0:
+        return previous
+    weight = frame / blend
+    result = []
+    for (old_pos, old_rot), (pos, rot) in zip(previous, current):
+        position = tuple(a + (b - a) * weight for a, b in zip(old_pos, pos))
+        # Quaternions q and -q represent the same orientation. Normalized
+        # shortest-path interpolation avoids a zero quaternion at the seam.
+        sign = -1 if sum(a * b for a, b in zip(old_rot, rot)) < 0 else 1
+        rotation = tuple(a + (sign * b - a) * weight for a, b in zip(old_rot, rot))
+        length = math.sqrt(sum(value * value for value in rotation))
+        result.append((position, tuple(value / length for value in rotation)))
+    return result
+
