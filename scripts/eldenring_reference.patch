@@ -0,0 +1,41 @@
+"""Small regression fixtures for the generator's attack-event selection."""
+import os
+from pathlib import Path
+import struct
+import tempfile
+import unittest
+
+from tae import Anim, Event
+
+# Importing the extractor validates ER_FILES. These fixtures require no game
+# data: its Source is never created and only pure event selection is exercised.
+with tempfile.TemporaryDirectory() as temporary:
+    Path(temporary, "chr").mkdir()
+    previous_files = os.environ.get("ER_FILES")
+    os.environ["ER_FILES"] = temporary
+    import extract
+    if previous_files is None:
+        del os.environ["ER_FILES"]
+    else:
+        os.environ["ER_FILES"] = previous_files
+
+
+def hit(start, end, judge, source=1, condition=0):
+    return Event(1, start, end, struct.pack("<iiiBBh", 0, 0, judge, 0, source, condition))
+
+
+class HitEventTests(unittest.TestCase):
+    def test_conditional_alternative_does_not_duplicate_real_hit(self):
+        animation = Anim(30000, [hit(.6, .7, 0), hit(.6, .7, 5000, condition=187)])
+        self.assertEqual(extract.hit_events(animation), [(18., 21., 0)])
+
+    def test_simultaneous_paired_hits_and_later_hits_remain_distinct(self):
+        animation = Anim(34000, [
+            hit(.6, .7, 800), hit(.6, .7, 805, source=2), hit(.8, .9, 810),
+            hit(.6, .7, 5000, condition=187), hit(.6, .7, 5006, source=2, condition=187),
+        ])
+        self.assertEqual(extract.hit_events(animation), [(18., 21., 800), (18., 21., 805), (24., 27., 810)])
+
+
+if __name__ == "__main__":
+    unittest.main()
